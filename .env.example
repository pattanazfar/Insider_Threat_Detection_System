ENVIRONMENT=production
DB_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME # Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=https://your-site.netlify.app
# Used only when running `python -m scripts.seed_users` from the backend directory.
SEED_ADMIN_USERNAME=User_name
SEED_ADMIN_PASSWORD=password
ADMIN_EMAIL=admin@example.com
BREVO_API_KEY=replace-with-your-brevo-api-key
ANALYST_EMAIL=analyst@example.com



